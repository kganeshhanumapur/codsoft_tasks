# Environment Variables for CareerHub Job Portal

# PostgreSQL Database URL (used by Prisma ORM)
# Example: postgresql://username:password@localhost:5432/careerhub?schema=public
# Or Neon / Supabase: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerhub?schema=public"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (Local disk or S3/Supabase/Cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"

# Optional Cloud Storage Keys (if using AWS S3 or Cloudinary)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=careerhub-resumes
